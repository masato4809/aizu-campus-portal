includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - app/
        - database/

    tmpDir: ./storage/phpstan

    # Level 10 is the highest level
    # 9以降は不毛な指摘やstanそのものに不具合がある、プロジェクトのさじ加減で調整してください
    level: 8

    # pre-commit analyzes only staged files; existing exclusions may not occur in that subset.
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # 問題ないマジックメソッドの除外.
        - '#Access to an undefined property App\\Models\\(.*)#'
        - '#Call to an undefined method Laravel\\Socialite\\Contracts\\Provider::stateless\(\)#'
        - identifier: cast.int
        - identifier: cast.string
